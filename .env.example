# ========================================================
# ETHIOPIAN RELATIONSHIP AWARENESS PLATFORM (.env.example)
# ========================================================

# Environment
NODE_ENV=production
PORT=4000
API_BASE_URL=https://taw-api.onrender.com

# CORS Configuration (Set to your Vercel URL or comma-separated origins)
CORS_ORIGIN=https://taw-admin.vercel.app,http://localhost:3000

# Security & Sessions
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
BOT_API_KEY=internal_bot_api_key_secret_for_secure_bot_to_api_calls_min_32_chars

# Neon PostgreSQL Database
# DATABASE_URL: Pooled connection string (with -pooler) used by Prisma Client at runtime
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL: Direct unpooled connection string used exclusively by Prisma Migrations
DIRECT_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudinary (Image & Photo Storage)
# Option A: Full Cloudinary URL
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option B: Individual Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=taw_submissions

# Redis & BullMQ Queue (Optional - automatically falls back to in-memory async executor if offline)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_SAMPLE_TOKEN
TELEGRAM_BOT_USERNAME=EthiopiaRelationshipBot
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_DISCUSSION_GROUP_ID=-1009876543210
# Set to true on Render Web Service to run the Bot and API inside the same service (saves hosting cost)
RUN_EMBEDDED_BOT=false

# Storage (Local fallback)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/attachments

# Initial Super Admin (For initial database seed)
INITIAL_ADMIN_EMAIL=admin@ethiopia-awareness.org
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_ADMIN_NAME="Platform Super Admin"

# Admin Dashboard Frontend (For Vercel environment variables)
VITE_API_BASE_URL=https://taw-api.onrender.com/api
VITE_TELEGRAM_CHANNEL_URL=https://t.me/ethiopia_awareness_posts
