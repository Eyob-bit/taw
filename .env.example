# ========================================================
# ETHIOPIAN RELATIONSHIP AWARENESS PLATFORM (.env.example)
# ========================================================

# Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Security & Sessions
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
BOT_API_KEY=internal_bot_api_key_secret_for_secure_bot_to_api_calls

# PostgreSQL Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relationship_platform?schema=public

# Redis & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_SAMPLE_TOKEN
TELEGRAM_BOT_USERNAME=EthiopiaRelationshipBot
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_DISCUSSION_GROUP_ID=-1009876543210
TELEGRAM_WEBHOOK_URL=

# Storage (Local or S3-compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/attachments
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Initial Super Admin (For initial seed)
INITIAL_ADMIN_EMAIL=admin@ethiopia-awareness.org
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_ADMIN_NAME="Platform Super Admin"

# Admin Dashboard Frontend
VITE_API_BASE_URL=http://localhost:4000/api
VITE_TELEGRAM_CHANNEL_URL=https://t.me/ethiopia_awareness_posts

